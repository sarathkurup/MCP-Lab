{
  "name": "mcplab",
  "displayName": "MCP Lab — MCP Inspector & Testing",
  "description": "MCP Inspector and testing for VS Code. Explore, execute, test and debug Model Context Protocol servers: schema-driven forms, protocol tracing, automated tests, diagnostics and security scanning.",
  "author": {
    "name": "Sarath Kumar"
  },
  "contributors": [
    {
      "name": "Sarath Kumar"
    }
  ],
  "version": "0.2.0",
  "publisher": "sarathkumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarathkurup/MCP-Lab.git"
  },
  "bugs": {
    "url": "https://github.com/sarathkurup/MCP-Lab/issues"
  },
  "homepage": "https://github.com/sarathkurup/MCP-Lab#readme",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Testing",
    "Debuggers"
  ],
  "keywords": [
    "mcp",
    "mcp lab",
    "lab",
    "mcp testing",
    "mcp debugging",
    "mcp inspector",
    "mcp client",
    "mcp server",
    "model context protocol",
    "inspector",
    "testing",
    "test runner",
    "debugger",
    "api testing",
    "swagger",
    "ai",
    "agent",
    "llm",
    "anthropic",
    "claude",
    "copilot"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcplab",
          "title": "MCP Lab",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "mcplab": [
        {
          "id": "mcplab.servers",
          "name": "MCP Servers",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mcplab.servers",
        "contents": "No MCP servers configured yet.\n[Add Server](command:mcplab.addServer)\nMCP Lab connects to local (stdio) and remote (streamable HTTP) MCP servers.\nConnecting to an organisation's MCP server with OAuth? Configure it as a project, then:\n[Select Project](command:mcplab.selectProject)"
      }
    ],
    "commands": [
      {
        "command": "mcplab.open",
        "title": "Open MCP Lab",
        "category": "MCP",
        "icon": "$(preview)"
      },
      {
        "command": "mcplab.openItem",
        "title": "Open in MCP Lab",
        "category": "MCP"
      },
      {
        "command": "mcplab.addServer",
        "title": "Add Server",
        "category": "MCP",
        "icon": "$(add)"
      },
      {
        "command": "mcplab.removeServer",
        "title": "Remove Server",
        "category": "MCP",
        "icon": "$(trash)"
      },
      {
        "command": "mcplab.connect",
        "title": "Connect",
        "category": "MCP",
        "icon": "$(plug)"
      },
      {
        "command": "mcplab.disconnect",
        "title": "Disconnect",
        "category": "MCP",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mcplab.reconnect",
        "title": "Reconnect",
        "category": "MCP",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mcplab.refresh",
        "title": "Refresh",
        "category": "MCP",
        "icon": "$(refresh)"
      },
      {
        "command": "mcplab.showLogs",
        "title": "Show Logs",
        "category": "MCP",
        "icon": "$(output)"
      },
      {
        "command": "mcplab.showTrace",
        "title": "Show Protocol Trace",
        "category": "MCP",
        "icon": "$(search)"
      },
      {
        "command": "mcplab.setAuthToken",
        "title": "Set Authentication Token",
        "category": "MCP",
        "icon": "$(key)"
      },
      {
        "command": "mcplab.clearAuthToken",
        "title": "Clear Authentication Token",
        "category": "MCP"
      },
      {
        "command": "mcplab.signIn",
        "title": "Sign In",
        "category": "MCP",
        "icon": "$(sign-in)"
      },
      {
        "command": "mcplab.signOut",
        "title": "Sign Out",
        "category": "MCP",
        "icon": "$(sign-out)"
      },
      {
        "command": "mcplab.selectProject",
        "title": "Select Project",
        "category": "MCP",
        "icon": "$(project)"
      },
      {
        "command": "mcplab.refreshTools",
        "title": "Refresh Tools",
        "category": "MCP",
        "icon": "$(refresh)"
      },
      {
        "command": "mcplab.reauthenticate",
        "title": "Reauthenticate",
        "category": "MCP",
        "icon": "$(key)"
      },
      {
        "command": "mcplab.showAuthDiagnostics",
        "title": "Show Authentication Diagnostics",
        "category": "MCP",
        "icon": "$(pulse)"
      },
      {
        "command": "mcplab.showAuthLog",
        "title": "Show Authentication Log",
        "category": "MCP",
        "icon": "$(output)"
      },
      {
        "command": "mcplab.storeClientSecret",
        "title": "Store OAuth Client Secret (Confidential Clients Only)",
        "category": "MCP"
      },
      {
        "command": "mcplab.showCapabilities",
        "title": "Show Server Capabilities",
        "category": "MCP",
        "icon": "$(info)"
      },
      {
        "command": "mcplab.copyDefinition",
        "title": "Copy Tool Definition",
        "category": "MCP",
        "icon": "$(copy)"
      },
      {
        "command": "mcplab.diagnose",
        "title": "Diagnose Server",
        "category": "MCP",
        "icon": "$(pulse)"
      },
      {
        "command": "mcplab.lint",
        "title": "Lint Server",
        "category": "MCP",
        "icon": "$(checklist)"
      },
      {
        "command": "mcplab.generateTests",
        "title": "Generate Tests",
        "category": "MCP",
        "icon": "$(beaker)"
      },
      {
        "command": "mcplab.saveAsTest",
        "title": "Save Invocation as Test",
        "category": "MCP"
      },
      {
        "command": "mcplab.analyzeFailure",
        "title": "Analyze Failure with AI",
        "category": "MCP"
      },
      {
        "command": "mcplab.switchEnvironment",
        "title": "Switch Environment",
        "category": "MCP",
        "icon": "$(globe)"
      },
      {
        "command": "mcplab.runTests",
        "title": "Run Tests",
        "category": "MCP",
        "icon": "$(beaker)"
      },
      {
        "command": "mcplab.generateDocs",
        "title": "Generate Documentation",
        "category": "MCP",
        "icon": "$(book)"
      },
      {
        "command": "mcplab.securityScan",
        "title": "Security Scan",
        "category": "MCP",
        "icon": "$(shield)"
      },
      {
        "command": "mcplab.compareServers",
        "title": "Compare Servers",
        "category": "MCP",
        "icon": "$(git-compare)"
      },
      {
        "command": "mcplab.createServer",
        "title": "Create Server",
        "category": "MCP",
        "icon": "$(new-folder)"
      },
      {
        "command": "mcplab.toolsFromOpenApi",
        "title": "Generate Tools from OpenAPI",
        "category": "MCP",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "mcplab.startBridge",
        "title": "Start MCP Bridge (expose MCP Lab to AI clients)",
        "category": "MCP",
        "icon": "$(broadcast)"
      },
      {
        "command": "mcplab.stopBridge",
        "title": "Stop MCP Bridge",
        "category": "MCP"
      },
      {
        "command": "mcplab.copyBridgeConfig",
        "title": "Copy MCP Bridge Client Config",
        "category": "MCP"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mcplab.open",
          "when": "view == mcplab.servers",
          "group": "navigation@0"
        },
        {
          "command": "mcplab.addServer",
          "when": "view == mcplab.servers",
          "group": "navigation@1"
        },
        {
          "command": "mcplab.refresh",
          "when": "view == mcplab.servers",
          "group": "navigation@2"
        },
        {
          "command": "mcplab.showTrace",
          "when": "view == mcplab.servers",
          "group": "navigation@3"
        },
        {
          "command": "mcplab.showLogs",
          "when": "view == mcplab.servers",
          "group": "navigation@4"
        },
        {
          "command": "mcplab.selectProject",
          "when": "view == mcplab.servers",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "mcplab.connect",
          "when": "view == mcplab.servers && viewItem =~ /^server:(disconnected|error)(:|$)/",
          "group": "inline@1"
        },
        {
          "command": "mcplab.disconnect",
          "when": "view == mcplab.servers && viewItem =~ /^server:connected(:|$)/",
          "group": "inline@1"
        },
        {
          "command": "mcplab.reconnect",
          "when": "view == mcplab.servers && viewItem =~ /^server:/",
          "group": "1_run@1"
        },
        {
          "command": "mcplab.showCapabilities",
          "when": "view == mcplab.servers && viewItem =~ /^server:connected(:|$)/",
          "group": "1_run@2"
        },
        {
          "command": "mcplab.setAuthToken",
          "when": "view == mcplab.servers && viewItem =~ /^server:/ && viewItem not =~ /:oauth:/",
          "group": "2_auth@1"
        },
        {
          "command": "mcplab.clearAuthToken",
          "when": "view == mcplab.servers && viewItem =~ /^server:/ && viewItem not =~ /:oauth:/",
          "group": "2_auth@2"
        },
        {
          "command": "mcplab.removeServer",
          "when": "view == mcplab.servers && viewItem =~ /^server:/",
          "group": "9_danger@1"
        },
        {
          "command": "mcplab.copyDefinition",
          "when": "view == mcplab.servers && viewItem =~ /^(tool|resource|prompt)$/",
          "group": "inline@1"
        },
        {
          "command": "mcplab.diagnose",
          "when": "view == mcplab.servers && viewItem =~ /^server:connected(:|$)/",
          "group": "1_run@3"
        },
        {
          "command": "mcplab.lint",
          "when": "view == mcplab.servers && viewItem =~ /^server:connected(:|$)/",
          "group": "1_run@4"
        },
        {
          "command": "mcplab.generateTests",
          "when": "view == mcplab.servers && viewItem == tool",
          "group": "inline@2"
        },
        {
          "command": "mcplab.securityScan",
          "when": "view == mcplab.servers && viewItem =~ /^server:connected(:|$)/",
          "group": "1_run@5"
        },
        {
          "command": "mcplab.generateDocs",
          "when": "view == mcplab.servers && viewItem =~ /^server:connected(:|$)/",
          "group": "1_run@6"
        },
        {
          "command": "mcplab.signIn",
          "when": "view == mcplab.servers && viewItem =~ /^server:.*:oauth:out$/",
          "group": "inline@0"
        },
        {
          "command": "mcplab.signIn",
          "when": "view == mcplab.servers && viewItem =~ /^server:.*:oauth:out$/",
          "group": "2_auth@0"
        },
        {
          "command": "mcplab.signOut",
          "when": "view == mcplab.servers && viewItem =~ /^server:.*:oauth:in$/",
          "group": "2_auth@3"
        },
        {
          "command": "mcplab.reauthenticate",
          "when": "view == mcplab.servers && viewItem =~ /^server:.*:oauth:/",
          "group": "2_auth@4"
        },
        {
          "command": "mcplab.showAuthDiagnostics",
          "when": "view == mcplab.servers && viewItem =~ /^server:.*:oauth:/",
          "group": "2_auth@5"
        },
        {
          "command": "mcplab.refreshTools",
          "when": "view == mcplab.servers && viewItem =~ /^server:connected(:|$)/",
          "group": "1_run@0"
        }
      ],
      "commandPalette": [
        {
          "command": "mcplab.openItem",
          "when": "false"
        },
        {
          "command": "mcplab.saveAsTest",
          "when": "false"
        },
        {
          "command": "mcplab.analyzeFailure",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "MCP Lab",
      "properties": {
        "mcplab.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Timeout in milliseconds for a single MCP request."
        },
        "mcplab.trace.maxEntries": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "description": "Maximum number of protocol trace entries kept in memory per session."
        },
        "mcplab.servers": {
          "type": "array",
          "default": [],
          "markdownDescription": "Workspace-shared MCP servers. Servers added through the UI are stored separately and are not written here. Secrets must never be placed in this setting - use **MCP: Set Authentication Token** instead.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "transport"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "env": {
                "type": "object"
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object"
              },
              "autoConnect": {
                "type": "boolean"
              },
              "environments": {
                "type": "object",
                "description": "Per-environment overrides, keyed by environment id."
              }
            }
          }
        },
        "mcplab.environments": {
          "type": "array",
          "default": [],
          "markdownDescription": "Environments MCP Lab can switch between. Leave empty to use the built-in DEV / QC / UAT / PROD. A server points at a different target per environment via its `environments` block.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "tier"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "dev",
                  "qc",
                  "uat",
                  "prod"
                ]
              },
              "color": {
                "type": "string"
              }
            }
          }
        },
        "mcplab.ai.permissions": {
          "type": "object",
          "default": {
            "readTools": true,
            "writeTools": false,
            "destructiveTools": false,
            "production": false
          },
          "markdownDescription": "What an AI client reaching MCP Lab through the MCP bridge may do without asking. Anything not allowed here prompts for human approval; nothing is ever silently denied.",
          "properties": {
            "readTools": {
              "type": "boolean",
              "description": "Allow read-only tools"
            },
            "writeTools": {
              "type": "boolean",
              "description": "Allow tools that write"
            },
            "destructiveTools": {
              "type": "boolean",
              "description": "Allow destructive tools"
            },
            "production": {
              "type": "boolean",
              "description": "Allow calls while a production environment is active"
            }
          }
        },
        "mcplab.maxReconnectAttempts": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "How many times to retry a dropped connection, with exponential backoff. 0 disables automatic reconnection."
        },
        "mcplab.redactSecrets": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Mask credentials (bearer tokens, API keys, private keys, JWTs) in log output. Logs are frequently pasted into issues and chats, so this is on by default."
        },
        "mcplab.projects": {
          "type": "array",
          "default": [],
          "markdownDescription": "MCP projects: an MCP endpoint and the OAuth configuration to reach it. Each project is self-contained - nothing is shared between projects. Any string may reference an environment variable as `${env:NAME}`. See the README for an example.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "mcpUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "Stable id; used to keep this project's tokens apart."
              },
              "displayName": {
                "type": "string"
              },
              "mcpUrl": {
                "type": "string",
                "description": "The MCP Streamable HTTP endpoint (not a .well-known URL)."
              },
              "oauth": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "clientId": {
                    "type": "string",
                    "description": "OAuth client id registered for this project. May be \"${env:NAME}\"."
                  },
                  "clientSecret": {
                    "type": "string",
                    "pattern": "^\\$\\{env:[A-Za-z_][A-Za-z0-9_]*\\}$",
                    "patternErrorMessage": "Only an environment reference such as ${env:MY_CLIENT_SECRET} is accepted here. Never put a secret in settings.",
                    "description": "Confidential clients only, and only as \"${env:NAME}\". Public clients using PKCE need no secret."
                  },
                  "scopes": {
                    "type": [
                      "array",
                      "string"
                    ],
                    "items": {
                      "type": "string"
                    },
                    "description": "Scopes to request, e.g. [\"offline_access\", \"api://app/Mcp.Read\"]."
                  },
                  "resource": {
                    "type": "string",
                    "description": "Protected resource identifier (RFC 8707). Defaults to mcpUrl."
                  },
                  "authority": {
                    "type": "string",
                    "description": "Expected authorization server (issuer). Pins discovery to it."
                  },
                  "discoveryUrl": {
                    "type": "string",
                    "description": "Authorization-server metadata URL; used only when discovery cannot find it."
                  },
                  "protectedResourceMetadataUrl": {
                    "type": "string",
                    "description": "Protected-resource metadata URL; used only when discovery cannot find it."
                  },
                  "redirectUri": {
                    "type": "string",
                    "description": "Exact redirect URI to send, when the identity provider needs a specific one."
                  },
                  "audience": {
                    "type": "string",
                    "description": "Expected access-token audience; enforced when set."
                  },
                  "trustedHosts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Extra hosts discovery may lead to without asking."
                  },
                  "resourceParameter": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "always",
                      "never"
                    ],
                    "default": "auto"
                  },
                  "callbackMode": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "uri",
                      "loopback"
                    ],
                    "default": "auto"
                  },
                  "strict": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "mcplab.selectedProject": {
          "type": "string",
          "default": "",
          "markdownDescription": "The project MCP commands act on when none is chosen explicitly. Set by **MCP: Select Project**."
        },
        "mcplab.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "MCP endpoint of the default project. Overrides the `MCP_URL` environment variable."
        },
        "mcplab.oauth.clientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "OAuth client id of the default project. Overrides `MCP_OAUTH_CLIENT_ID`."
        },
        "mcplab.oauth.clientSecret": {
          "type": "string",
          "default": "",
          "pattern": "^(\\$\\{env:[A-Za-z_][A-Za-z0-9_]*\\})?$",
          "patternErrorMessage": "Only an environment reference such as ${env:MCP_OAUTH_CLIENT_SECRET} is accepted. Never put a secret in settings.",
          "markdownDescription": "Confidential clients only: an **environment reference** such as `${env:MCP_OAUTH_CLIENT_SECRET}`. A secret written here is refused. Public clients using PKCE need no secret; prefer **MCP: Store OAuth Client Secret** if one is unavoidable."
        },
        "mcplab.oauth.scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "OAuth scopes of the default project. Overrides `MCP_OAUTH_SCOPES` (space-separated)."
        },
        "mcplab.oauth.resource": {
          "type": "string",
          "default": "",
          "markdownDescription": "Protected resource (RFC 8707) of the default project. Defaults to the MCP URL. Overrides `MCP_OAUTH_RESOURCE`."
        },
        "mcplab.oauth.authority": {
          "type": "string",
          "default": "",
          "markdownDescription": "Expected authorization server of the default project. Overrides `MCP_OAUTH_AUTHORITY`. When set, discovery may only lead there."
        },
        "mcplab.oauth.discoveryUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Authorization-server metadata URL, used only when discovery cannot find it. Overrides `MCP_OAUTH_DISCOVERY_URL`."
        },
        "mcplab.oauth.protectedResourceMetadataUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Protected-resource metadata URL, used only when discovery cannot find it. Overrides `MCP_OAUTH_PROTECTED_RESOURCE_METADATA_URL`."
        },
        "mcplab.oauth.redirectUri": {
          "type": "string",
          "default": "",
          "markdownDescription": "Exact redirect URI to send. Leave empty to use the one this editor resolves (logged in **MCP Lab: Auth**). Overrides `MCP_OAUTH_REDIRECT_URI`."
        },
        "mcplab.oauth.audience": {
          "type": "string",
          "default": "",
          "markdownDescription": "Expected access-token audience for the default project. When set it is enforced."
        },
        "mcplab.oauth.trustedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Hosts discovery may lead to without asking, for the default project, e.g. a separate token host."
        },
        "mcplab.oauth.resourceParameter": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "markdownDescription": "When to send the RFC 8707 `resource` parameter. `auto`: when the resource is configured or the server publishes protected-resource metadata. Use `never` for identity providers that identify the API through scopes and reject the parameter."
        },
        "mcplab.oauth.callbackMode": {
          "type": "string",
          "enum": [
            "auto",
            "uri",
            "loopback"
          ],
          "default": "auto",
          "markdownDescription": "How the browser returns to the editor. `uri`: the editor's URI handler (works in Remote SSH, WSL, containers and Codespaces). `loopback`: a one-shot listener on 127.0.0.1 with an OS-assigned port. `auto`: the URI handler when available."
        },
        "mcplab.oauth.strict": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Refuse anything that cannot be verified - an identity provider that does not advertise PKCE S256, or an access token whose issuer or audience does not match - instead of warning."
        },
        "mcplab.debugLogging": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Write debug-level events to **MCP Lab: Auth**. Secrets are never logged at any level."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "mcplab.mcp",
        "name": "mcp",
        "fullName": "MCP Lab",
        "description": "Ask about the MCP servers configured in this workspace",
        "isSticky": true,
        "commands": [
          {
